<main>
  <h1>Create your account</h1>
  <p>Step 1 of 2 — Account credentials</p>
  <p>Your progress is saved after this step so you can sign out and resume later.</p>

  <% if @user.errors.any? %>
    <div role="alert">
      <p>We could not save this registration step.</p>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: registration_path do |form| %>
    <div>
      <%= form.label :email %>
      <%= form.email_field :email, required: true, autocomplete: "email" %>
    </div>

    <div>
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "new-password" %>
    </div>

    <div>
      <%= form.label :password_confirmation %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
    </div>

    <%= form.submit "Save and continue" %>
  <% end %>
</main>
