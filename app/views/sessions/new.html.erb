<main>
  <h1>Sign in</h1>

  <% if flash.now[:alert].present? %>
    <p role="alert"><%= flash.now[:alert] %></p>
  <% end %>

  <%= form_with url: session_path do |form| %>
    <div>
      <%= form.label :email %>
      <%= form.email_field :email, required: true, autocomplete: "email" %>
    </div>

    <div>
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "current-password" %>
    </div>

    <%= form.submit "Sign in" %>
  <% end %>

  <p><%= link_to "Forgot your password?", new_password_reset_path %></p>
</main>
